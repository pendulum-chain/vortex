# Public CDP project identifier. The project must use custom authentication.
VITE_CDP_PROJECT_ID=

# Vortex API that issues and verifies the existing Supabase JWT.
VITE_API_URL=http://localhost:3000

# Optional RPC overrides. Public viem defaults are used when omitted.
VITE_BASE_SEPOLIA_RPC_URL=
VITE_BSC_TESTNET_RPC_URL=

# Optional exact parent origin when testing against a deployed host.
VITE_SPIKE_PARENT_ORIGIN=
