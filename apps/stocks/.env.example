# Local visual QA: demo = fake login + simulated ramp, no real authentication or money movement.
VITE_STOCKS_MODE=demo
# Only honoured when VITE_STOCKS_MODE=live. Leave unset until Vortex supports the Robinhood Chain route.
VITE_STOCKS_RAMP_ENABLED=
# Public Privy App ID. It MUST be the same as Gold's for the shared login. Never put the Privy App Secret here.
VITE_PRIVY_APP_ID=cmtiwhqgf01uu0el8lx3ejr35
# Same-origin API proxy (vite dev proxy / Netlify _redirects). pk_* is optional; sk_* is forbidden.
VITE_SIGNING_SERVICE_PATH=/api/production
VITE_VORTEX_PUBLIC_KEY=
# Assumed Vortex contract. Change only if Vortex names the network differently (tokens are always
# identified by their contract address).
VITE_STOCKS_NETWORK=robinhood
# Optional browser RPC for Robinhood Chain (e.g. Alchemy). It MUST be an origin-restricted key: it is public in the bundle.
VITE_ROBINHOOD_RPC_URL=
