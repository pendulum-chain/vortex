# Local visual QA: demo = fake login + simulated ramp, no real authentication or money movement. A build fails on a bad value.
VITE_STOCKS_MODE=demo
# Only honoured when VITE_STOCKS_MODE=live, and changing it needs a rebuild. Leave unset until the API's STOCKS_ENABLED_DIRECTIONS lists a direction.
VITE_STOCKS_RAMP_ENABLED=
# Public Privy App ID. It MUST be the same as Gold's for the shared login. Never put the Privy App Secret here.
VITE_PRIVY_APP_ID=cmtiwhqgf01uu0el8lx3ejr35
# Same-origin API proxy (vite dev proxy / Netlify _redirects). The app sends no API key: a sk_* value in any VITE_* variable fails the build.
VITE_SIGNING_SERVICE_PATH=/api/production
# The Vortex network id. Tokens are identified by symbol, which the API's allowlist pins to one contract.
VITE_STOCKS_NETWORK=robinhood
# Optional browser RPC for Robinhood Chain (e.g. Alchemy). It MUST be an origin-restricted key: it is public in the bundle.
VITE_ROBINHOOD_RPC_URL=
