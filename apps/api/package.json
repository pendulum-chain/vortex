    "@polkadot/types": "catalog:",
    "@polkadot/types-codec": "catalog:",
    "@swc-node/register": "^1.10.10",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.10.4",
    "@types/big.js": "catalog:",
    "@types/body-parser": "^1.19.5",
    "@types/bun": "^1.3.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/method-override": "^3.0.0",
